{
  "name": "physics-setup-blog",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write \"src/**/*.{astro,css,ts}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{astro,css,ts}\" \"*.{js,json,md}\"",
