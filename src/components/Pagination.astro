---
const { currentPage, totalPages, basePath } = Astro.props as {
  currentPage: number;
  totalPages: number;
  basePath: string;
};
const hrefFor = (page: number) =>
  page === 1 ? `${basePath}/` : `${basePath}/page/${page}/`;
const pages = Array.from({ length: totalPages }, (_, index) => index + 1);
---

{totalPages > 1 && (
  <nav class="pagination" aria-label="ページ送り">
    {currentPage > 1 && (
      <a class="pagination-arrow" rel="prev" href={hrefFor(currentPage - 1)}>
        ← 前へ
      </a>
    )}
    <div class="pagination-pages">
      {pages.map((page) => (
        <a
          href={hrefFor(page)}
          class:list={{ active: page === currentPage }}
          aria-current={page === currentPage ? "page" : undefined}
        >
          {page}
        </a>
      ))}
    </div>
    {currentPage < totalPages && (
      <a class="pagination-arrow" rel="next" href={hrefFor(currentPage + 1)}>
        次へ →
      </a>
    )}
  </nav>
)}

<style>
  .pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
    margin: 42px 0;
  }
  .pagination-pages {
    display: flex;
    justify-content: center;
    gap: 8px;
  }
  .pagination a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    height: 38px;
    padding: 0 10px;
    border: 1px solid var(--line);
    background: var(--white);
    font-size: 0.85rem;
  }
  .pagination a:hover {
    border-color: var(--teal);
    color: var(--teal);
  }
  .pagination a.active {
    border-color: var(--teal);
    background: var(--teal);
    color: #fff;
    font-weight: 700;
  }
  .pagination-arrow:first-child {
    justify-self: start;
  }
  .pagination-arrow:last-child {
    justify-self: end;
  }
  @media (max-width: 600px) {
    .pagination {
      grid-template-columns: 1fr 1fr;
    }
    .pagination-pages {
      grid-column: 1/-1;
      grid-row: 1;
      flex-wrap: wrap;
    }
    .pagination-arrow {
      grid-row: 2;
    }
    .pagination-arrow:last-child {
      grid-column: 2;
    }
  }
</style>
