---
interface Props {
  href: string;
  label: string;
  supportingText?: string;
  variant?: "primary" | "secondary";
  external?: boolean;
}

const {
  href,
  label,
  supportingText,
  variant = "primary",
  external = false,
} = Astro.props;

const rel = external ? "noopener noreferrer" : undefined;
const target = external ? "_blank" : undefined;
---

<div class:list={["cta", `cta--${variant}`]}>
  {supportingText && <p class="cta__supporting-text">{supportingText}</p>}
  <a class="cta__button" href={href} rel={rel} target={target}>
    <span>{label}</span>
    <svg class="cta__icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 12h13M13 6l6 6-6 6" />
    </svg>
  </a>
</div>

<style>
  .cta {
    width: min(100%, 38rem);
    margin: 3.5rem auto;
    text-align: center;
  }

  .cta__supporting-text {
    margin: 0 0 0.75rem;
    color: var(--lp-brown);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.6;
  }

  .cta__button {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    min-height: 4.75rem;
    padding: 1rem 1.4rem 1rem 2rem;
    border: 1px solid #718c24;
    color: #26320f;
    font-family: "Noto Sans JP", "Yu Gothic", sans-serif;
    font-size: clamp(1.05rem, 2.4vw, 1.25rem);
    font-weight: 700;
    line-height: 1.5;
    text-align: center;
    text-decoration: none;
    box-shadow: 0 1rem 2.5rem rgba(82, 72, 61, 0.18);
    transition:
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      background-size 0.35s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.25s ease;
  }

  .cta--primary .cta__button {
    background: radial-gradient(
      circle at center,
      #e7ff79 0%,
      #c5e74e 38%,
      #91b62d 72%,
      #6f8d22 100%
    );
    background-size: 100% 100%;
  }

  .cta--secondary .cta__button {
    background: radial-gradient(
      circle at center,
      #ddf56c 0%,
      #b7d843 42%,
      #789824 100%
    );
    background-size: 100% 100%;
    border-color: #647e20;
  }

  .cta__button:hover {
    color: #1f290c;
    background-size: 118% 118%;
    box-shadow: 0 1.25rem 3rem rgba(90, 112, 31, 0.25);
    transform: translateY(-2px);
  }

  .cta__button:active {
    transform: translateY(1px) scale(0.99);
  }

  .cta__button:focus-visible {
    outline: 3px solid rgba(139, 70, 61, 0.28);
    outline-offset: 4px;
  }

  .cta__icon {
    width: 2.25rem;
    height: 2.25rem;
    padding: 0.45rem;
    border: 1px solid rgba(38, 50, 15, 0.42);
    border-radius: 50%;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cta__button:hover .cta__icon {
    transform: translateX(3px);
  }

  @media (max-width: 700px) {
    .cta {
      margin-block: 2.75rem;
    }

    .cta__button {
      min-height: 4.25rem;
      padding: 0.9rem 1rem 0.9rem 1.25rem;
    }

    .cta__icon {
      width: 2rem;
      height: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta__button,
    .cta__icon {
      transition: none;
    }
  }
</style>
