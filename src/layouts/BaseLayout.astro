---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string | null;
  image?: string;
  noindex?: boolean;
}

const {
  title = "受験物理 Set Up",
  description = "大学受験物理を、基礎からわかりやすく。",
  canonical,
  image,
  noindex = false,
} = Astro.props;

const canonicalUrl =
  canonical ||
  new URL(Astro.url.pathname, Astro.site || Astro.url.origin).toString();

const ga4MeasurementId = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID?.trim();
const adsenseClientId = import.meta.env.PUBLIC_GOOGLE_ADSENSE_CLIENT_ID?.trim();
const enableGa4 =
  import.meta.env.PROD && /^G-[A-Z0-9]+$/i.test(ga4MeasurementId || "");
const enableAdsense =
  import.meta.env.PROD && /^ca-pub-\d+$/i.test(adsenseClientId || "");
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <link rel="icon" type="image/png" href="/site-logo.png" />
    <link rel="apple-touch-icon" href="/site-logo.png" />
    {enableAdsense && (
      <meta name="google-adsense-account" content={adsenseClientId} />
    )}
    {enableGa4 && (
      <>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${ga4MeasurementId}`}
        ></script>
        <script is:inline define:vars={{ ga4MeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag("js", new Date());
          gtag("config", ga4MeasurementId);
        </script>
      </>
    )}
    {enableAdsense && (
      <script
        is:inline
        async
        crossorigin="anonymous"
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClientId}`}
      ></script>
    )}
    <!-- <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.4/dist/katex.min.css" integrity="sha384-vZTGshhcJwVjMEcoCsoDhbLMegZbDrg6eRmFwhl/8tSru3CTb5EgGF9aFLPeANtO" crossorigin="anonymous"> -->
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      本文へ移動
    </a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
