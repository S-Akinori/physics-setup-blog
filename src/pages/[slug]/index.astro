---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import Comments from "../../components/Comments.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import {
  categoryUrl,
  cmsApiBase,
  excerpt,
  formatDate,
  getAllContent,
  getTaxonomies,
  type CmsContent,
} from "../../lib/cms";
import { renderMarkdown } from "../../lib/markdown";

export async function getStaticPaths() {
  const [content, taxonomies] = await Promise.all([
    getAllContent(),
    getTaxonomies(),
  ]);
  const posts = content.filter((item) => item.type === "post");
  return content.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry, posts, categories: taxonomies.categories },
  }));
}

const { entry, posts, categories } = Astro.props as {
  entry: CmsContent;
  posts: CmsContent[];
  categories: Awaited<ReturnType<typeof getTaxonomies>>["categories"];
};

const rendered = await renderMarkdown(entry.bodyMarkdown || "");
const title = entry.seo.title || `${entry.title} | 受験物理 Set Up`;
const description = entry.seo.description || excerpt(entry);
---

<BaseLayout
  title={title}
  description={description}
  canonical={entry.seo.canonicalUrl}
  image={entry.featuredImage?.url}
  noindex={entry.seo.noindex || entry.passwordProtected}
>
  <div class="container">
    <div class="breadcrumb">
      <a href="/">ホーム</a>
      {entry.category && (
        <>
          　/　<a href={categoryUrl(entry.category)}>{entry.category.name}</a>
        </>
      )}
      　/　{entry.title}
    </div>
    <div class="content-grid article-page">
      <article id="article-start">
        {entry.passwordProtected ? (
          <section class="protected-content" aria-labelledby="protected-title">
            <div class="eyebrow">PROTECTED</div>
            <h1 id="protected-title">{entry.title}</h1>
            <div data-password-gate>
              <p data-password-message>
                このページはパスワードで保護されています。
              </p>
              <form
                class="password-form"
                data-password-form
                data-content-type={entry.type}
                data-content-slug={entry.slug}
              >
                <label for="content-password">パスワード</label>
                <div class="password-fields">
                  <input
                    id="content-password"
                    name="password"
                    type="password"
                    required
                    autocomplete="current-password"
                  />
                  <button class="btn" type="submit">
                    閲覧する
                  </button>
                </div>
              </form>
              <p class="protected-help">
                認証後7日間は、この端末でパスワードの再入力が不要です。
                パスワードはブラウザには保存されません。
              </p>
            </div>
            <nav
              class="protected-toc"
              data-protected-toc
              aria-labelledby="protected-toc-title"
              hidden
            >
              <h2 id="protected-toc-title">この記事の目次</h2>
              <ol data-protected-toc-list></ol>
            </nav>
            <div class="prose" data-protected-body></div>
          </section>
        ) : (
          <>
            <header>
              {entry.category && (
                <div class="article-meta">{entry.category.name}</div>
              )}
              <h1>{entry.title}</h1>
              {entry.description && <p class="lead">{entry.description}</p>}
              <div class="article-dates">
                <time datetime={entry.publishedAt}>
                  {formatDate(entry.publishedAt)}
                </time>
                　更新日{" "}
                <time datetime={entry.updatedAt}>
                  {formatDate(entry.updatedAt)}
                </time>
              </div>
              {entry.featuredImage && (
                <img
                  class="article-hero"
                  src={entry.featuredImage.url}
                  alt={entry.featuredImage.alt || entry.title}
                />
              )}
            </header>
            <TableOfContents headings={rendered.metadata.headings} />
            <div class="prose" set:html={rendered.code} />
            {entry.commentsEnabled &&
              cmsApiBase &&
              !entry.passwordProtected && (
                <Comments
                  apiBase={cmsApiBase}
                  slug={entry.slug}
                  type={entry.type === "page" ? "pages" : "posts"}
                />
              )}
          </>
        )}
        <a
          class="back-to-article-top"
          href="#article-start"
          aria-label="記事の最初に戻る"
        >
          <span aria-hidden="true">↑</span>
          記事の最初に戻る
        </a>
      </article>
      <Sidebar articles={posts} categories={categories} />
    </div>
  </div>
</BaseLayout>

<script>
  import {
    enhanceRenderedMarkdown,
    renderMarkdownInto,
  } from "../../lib/client-markdown";

  document.querySelectorAll<HTMLElement>(".prose").forEach((container) => {
    void enhanceRenderedMarkdown(container);
  });

  const passwordForm = document.querySelector<HTMLFormElement>(
    "[data-password-form]",
  );
  const loadProtectedContent = async (password?: FormDataEntryValue) => {
    if (!passwordForm) return;
    const gate = document.querySelector<HTMLElement>("[data-password-gate]");
    const message = document.querySelector<HTMLElement>(
      "[data-password-message]",
    );
    const body = document.querySelector<HTMLElement>("[data-protected-body]");
    const toc = document.querySelector<HTMLElement>("[data-protected-toc]");
    const tocList = document.querySelector<HTMLOListElement>(
      "[data-protected-toc-list]",
    );
    const submit = passwordForm.querySelector<HTMLButtonElement>("button");
    if (!message || !body) return;
    message.textContent = password
      ? "確認しています…"
      : "認証状態を確認しています…";
    if (submit) submit.disabled = true;

    try {
      const response = await fetch("/api/content.php", {
        method: "POST",
        credentials: "same-origin",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: JSON.stringify({
          type: passwordForm.dataset.contentType,
          slug: passwordForm.dataset.contentSlug,
          ...(password ? { password } : {}),
        }),
      });
      const payload = await response.json().catch(() => null);
      if (response.status === 401 && !password) {
        message.textContent = "このページはパスワードで保護されています。";
        if (submit) submit.disabled = false;
        return;
      }
      if (response.status === 401)
        throw new Error("パスワードが正しくありません。");
      if (response.status === 429)
        throw new Error(
          "試行回数が多すぎます。時間を置いて再試行してください。",
        );
      if (!response.ok || !payload?.data?.bodyMarkdown) {
        throw new Error("限定公開ページを取得できませんでした。");
      }

      await renderMarkdownInto(payload.data.bodyMarkdown, body);

      const headings = [...body.querySelectorAll<HTMLHeadingElement>("h2, h3")];
      headings.forEach((heading, index) => {
        heading.id = `protected-heading-${index + 1}`;
      });
      if (toc && tocList && headings.length > 0) {
        tocList.replaceChildren(
          ...headings.map((heading) => {
            const item = document.createElement("li");
            if (heading.tagName === "H3") item.className = "toc-child";
            const link = document.createElement("a");
            link.href = `#${heading.id}`;
            link.textContent = heading.textContent || "";
            item.append(link);
            return item;
          }),
        );
        toc.hidden = false;
      }
      if (gate) gate.hidden = true;
    } catch (error) {
      message.textContent =
        error instanceof Error ? error.message : "認証できませんでした。";
      if (submit) submit.disabled = false;
    }
  };

  passwordForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const password = new FormData(passwordForm).get("password");
    if (password) void loadProtectedContent(password);
  });

  if (passwordForm) void loadProtectedContent();

  const backToTop = document.querySelector<HTMLElement>(".back-to-article-top");
  const updateBackToTop = () => {
    backToTop?.classList.toggle("is-visible", window.scrollY > 480);
  };
  window.addEventListener("scroll", updateBackToTop, { passive: true });
  updateBackToTop();
</script>

<style>
  .article-page h1 {
    font-size: 2.7rem;
    line-height: 1.3;
    margin: 6px 0 8px;
  }
  .protected-content {
    max-width: 680px;
    padding: 56px 0 80px;
  }
  .protected-content h1 {
    margin: 8px 0 18px;
  }
  .protected-content p {
    margin: 0 0 12px;
  }
  .protected-help {
    color: var(--muted);
    font-size: 0.88rem;
  }
  .password-form {
    max-width: 520px;
    margin: 28px 0 16px;
  }
  .password-form label {
    display: block;
    margin-bottom: 7px;
    font-size: 0.82rem;
    font-weight: 700;
  }
  .password-fields {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
  }
  .password-fields input {
    width: 100%;
    min-height: 46px;
    padding: 9px 12px;
    border: 1px solid #aebfc5;
    border-radius: 3px;
    background: #fff;
  }
  .password-fields button:disabled {
    cursor: wait;
    opacity: 0.65;
  }
  .protected-toc {
    margin: 34px 0 46px;
    padding: 22px 26px;
    border: 1px solid var(--line);
    background: rgba(255, 253, 249, 0.72);
  }
  .protected-toc h2 {
    margin: 0 0 12px;
    font-size: 1.12rem;
  }
  .protected-toc ol {
    margin: 0;
    padding: 12px 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .protected-toc li + li {
    margin-top: 7px;
  }
  .protected-toc .toc-child {
    padding-left: 22px;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .protected-toc a:hover {
    color: var(--teal);
  }
  #article-start {
    scroll-margin-top: 96px;
  }
  .back-to-article-top {
    position: fixed;
    right: max(20px, calc((100vw - var(--max)) / 2));
    bottom: 24px;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--white);
    box-shadow: 0 8px 24px rgba(16, 42, 67, 0.14);
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 700;
    visibility: hidden;
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
    transition:
      color 0.2s,
      border-color 0.2s,
      transform 0.2s,
      opacity 0.2s,
      visibility 0.2s;
  }
  .back-to-article-top.is-visible {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .back-to-article-top:hover {
    border-color: var(--teal);
    color: var(--teal);
    transform: translateY(-2px);
  }
  .lead {
    font-size: 1.15rem;
    margin: 0 0 6px;
  }
  .article-dates {
    color: var(--muted);
    font-size: 0.78rem;
  }
  .article-hero {
    aspect-ratio: 3/2;
    margin: 22px 0 24px;
    border-radius: 5px;
  }
  .author-box {
    border: 1px solid var(--line);
    padding: 20px;
    margin-top: 42px;
  }
  :global(.prose) {
    font-size: 1rem;
    max-width: 70ch;
  }
  :global(.prose h2) {
    font-size: 2rem;
    line-height: 1.35;
    margin: 58px 0 18px;
    letter-spacing: -0.025em;
    scroll-margin-top: 24px;
  }
  :global(.prose h2:after) {
    content: "";
    display: block;
    width: 52px;
    height: 3px;
    background: var(--teal);
    margin-top: 9px;
  }
  :global(.prose h3) {
    font-size: 1.35rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 8px;
    margin: 42px 0 14px;
    scroll-margin-top: 24px;
  }
  :global(.prose ul) {
    padding-left: 0;
    list-style: none;
  }
  :global(.prose ul li) {
    position: relative;
    padding-left: 24px;
    margin: 8px 0;
  }
  :global(.prose ul li:before) {
    content: "";
    width: 8px;
    height: 8px;
    background: var(--teal);
    position: absolute;
    left: 0;
    top: 0.72em;
  }
  :global(.prose ol) {
    padding-left: 1.4rem;
  }
  :global(.prose ol li) {
    padding-left: 7px;
    margin: 8px 0;
  }
  :global(.prose > p),
  :global(.prose > ul),
  :global(.prose > ol),
  :global(.prose > blockquote) {
    margin-block: 16px;
  }
  :global(.prose blockquote) {
    margin-inline: 0;
    padding: 8px 20px;
    border-left: 3px solid var(--teal);
    background: #eaf3f2;
  }
  :global(.prose .qiita-note) {
    position: relative;
    padding: 18px 20px 18px 52px;
    border: 1px solid #b7d7d7;
    border-left: 4px solid var(--teal);
    background: #edf7f6;
  }
  :global(.prose .qiita-note:before) {
    content: "i";
    position: absolute;
    top: 18px;
    left: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border: 2px solid currentColor;
    border-radius: 50%;
    color: var(--teal);
    font-size: 0.78rem;
    font-weight: 800;
    line-height: 1;
  }
  :global(.prose .qiita-note-warn) {
    border-color: #edc38e;
    border-left-color: var(--orange);
    background: #fff5e8;
  }
  :global(.prose .qiita-note-warn:before) {
    content: "!";
    color: var(--orange);
  }
  :global(.prose .qiita-note-alert) {
    border-color: #e3b2b2;
    border-left-color: #b84a4a;
    background: #fff0f0;
  }
  :global(.prose .qiita-note-alert:before) {
    content: "!";
    color: #b84a4a;
  }
  :global(.prose .qiita-note > :first-child) {
    margin-top: 0;
  }
  :global(.prose .qiita-note > :last-child) {
    margin-bottom: 0;
  }
  :global(.prose figure) {
    margin: 24px 0;
  }
  :global(.prose figure img) {
    aspect-ratio: 16/6;
    border-radius: 5px;
  }
  :global(.prose figcaption) {
    text-align: center;
    color: var(--muted);
    font-size: 0.76rem;
    margin-top: 8px;
  }
  :global(.prose code) {
    font-family: "IBM Plex Mono", Consolas, monospace;
    background: #dfeff1;
    color: var(--ink);
    padding: 0.14em 0.38em;
    border-radius: 2px;
  }
  :global(.prose pre) {
    position: relative;
    background: #082842;
    color: #eff8f8;
    border-radius: 4px;
    padding: 18px 22px;
    overflow: auto;
  }
  :global(.prose pre[data-code-title]) {
    padding-top: 52px;
  }
  :global(.prose pre[data-code-title]:before) {
    content: attr(data-code-title);
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    display: flex;
    align-items: center;
    min-height: 34px;
    padding: 0 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.07);
    color: #c8dde7;
    font-family: "IBM Plex Mono", Consolas, monospace;
    font-size: 0.76rem;
  }
  :global(.prose .qiita-code-title) {
    min-height: 36px;
    margin: 24px 0 0;
    padding: 7px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 4px 4px 0 0;
    background: #123852;
    color: #c8dde7;
    font-family: "IBM Plex Mono", Consolas, monospace;
    font-size: 0.76rem;
  }
  :global(.prose .qiita-code-title + pre) {
    margin-top: 0;
    border-radius: 0 0 4px 4px;
  }
  :global(.prose pre code) {
    background: none;
    color: inherit;
    padding: 0;
  }
  :global(.prose > img),
  :global(.prose p > img) {
    border-radius: 5px;
    margin: 24px 0;
  }
  :global(.prose a) {
    color: var(--teal);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  :global(.prose table) {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
  }
  :global(.prose th),
  :global(.prose td) {
    padding: 10px 12px;
    border: 1px solid var(--line);
    text-align: left;
  }
  :global(.prose th) {
    background: #eaf3f2;
  }
  :global(.prose .contains-task-list) {
    padding-left: 0;
    list-style: none;
  }
  :global(.prose .task-list-item) {
    padding-left: 28px;
  }
  :global(.prose .task-list-item:before) {
    display: none;
  }
  :global(.prose .task-list-item input) {
    position: absolute;
    left: 0;
    top: 0.48em;
    width: 16px;
    height: 16px;
    accent-color: var(--teal);
  }
  :global(.prose .footnotes) {
    margin-top: 48px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.88rem;
  }
  :global(.prose .footnotes ol) {
    margin: 0;
  }
  :global(.prose [data-footnote-ref]) {
    margin-inline: 2px;
    font-size: 0.78em;
    font-weight: 800;
    text-decoration: none;
  }
  :global(.prose [data-footnote-backref]) {
    margin-left: 5px;
    text-decoration: none;
  }
  :global(.prose .mermaid-diagram) {
    margin: 28px 0;
    padding: 20px;
    overflow-x: auto;
    border: 1px solid var(--line);
    background: var(--white);
  }
  :global(.prose .mermaid-diagram svg) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
  }
  :global(.prose pre.mermaid-error:after) {
    content: "Mermaid図を表示できませんでした";
    display: block;
    margin-top: 12px;
    color: #ffc5c5;
    font-size: 0.78rem;
  }
  @media (max-width: 600px) {
    .article-page h1 {
      font-size: 2rem;
    }
    :global(.prose h2) {
      font-size: 1.6rem;
    }
    .back-to-article-top {
      right: 15px;
      bottom: 15px;
      width: 44px;
      padding: 0;
      justify-content: center;
      overflow: hidden;
      color: transparent;
      font-size: 0;
    }
    .back-to-article-top span {
      color: var(--ink);
      font-size: 1.2rem;
    }
    .password-fields {
      grid-template-columns: 1fr;
    }
  }
</style>
