---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Sidebar from "../../../components/Sidebar.astro";
import ArchiveList from "../../../components/ArchiveList.astro";
import Pagination from "../../../components/Pagination.astro";
import {
  ARTICLES_PER_PAGE,
  getPosts,
  getTaxonomies,
  type Taxonomy,
} from "../../../lib/cms";

export const prerender = true;

type Post = Awaited<ReturnType<typeof getPosts>>[number];

export async function getStaticPaths() {
  const [posts, taxonomies] = await Promise.all([getPosts(), getTaxonomies()]);
  return taxonomies.categories.map((category) => ({
    params: { slug: category.slug },
    props: {
      category,
      articles: posts.filter((post) => post.category?.slug === category.slug),
      allPosts: posts,
      categories: taxonomies.categories,
    },
  }));
}

const { category, articles, allPosts, categories } = Astro.props as {
  category: Taxonomy;
  articles: Post[];
  allPosts: Post[];
  categories: Taxonomy[];
};
const totalPages = Math.ceil(articles.length / ARTICLES_PER_PAGE);
const visibleArticles = articles.slice(0, ARTICLES_PER_PAGE);
const description = `${category.name}の基礎から入試問題まで、順番に学べる記事をまとめています。`;
---

<BaseLayout
  title={`${category.name}の記事一覧 | 受験物理 Set Up`}
  description={description}
>
  <div class="container">
    <div class="breadcrumb">
      <a href="/">ホーム</a>　/　{category.name}
    </div>

    <header class="page-head">
      <div class="eyebrow">CATEGORY</div>
      <h1>{category.name}の記事一覧</h1>
      <p>{description}</p>
      <div class="date">全{articles.length}記事</div>
    </header>

    <div class="content-grid">
      <div>
        <ArchiveList articles={visibleArticles} />
        <Pagination
          currentPage={1}
          totalPages={totalPages}
          basePath={`/category/${category.slug}`}
        />
      </div>
      <Sidebar articles={allPosts} categories={categories} />
    </div>
  </div>
</BaseLayout>
