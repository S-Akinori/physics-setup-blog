---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import ArchiveList from "../../components/ArchiveList.astro";
import { getPosts, getTaxonomies } from "../../lib/cms";
export const prerender = true;
const [articles, taxonomies] = await Promise.all([getPosts(), getTaxonomies()]);
---

<BaseLayout title="検索 | 受験物理 Set Up" noindex={true}>
  <div class="container search-page">
    <div class="breadcrumb">
      <a href="/">ホーム</a>　/　検索
    </div>
    <header class="page-head">
      <div class="eyebrow">SEARCH</div>
      <h1 data-search-title>記事を検索</h1>
      <p>タイトル、本文、カテゴリー、タグから検索できます。</p>
      <div class="date" data-search-count>
        {articles.length}件の記事
      </div>
    </header>
    <div class="content-grid">
      <ArchiveList articles={articles} />
      <Sidebar articles={articles} categories={taxonomies.categories} />
    </div>
  </div>
</BaseLayout>
<script>
  const pageSize = 10;
  const params = new URLSearchParams(location.search);
  const query = (params.get("q") || "").trim().toLowerCase();
  const items = [
    ...document.querySelectorAll<HTMLElement>("[data-search-item]"),
  ];
  const matchedItems = items.filter(
    (item) => !query || (item.dataset.search || "").includes(query),
  );
  const totalPages = Math.max(1, Math.ceil(matchedItems.length / pageSize));
  const requestedPage = Number.parseInt(params.get("page") || "1", 10);
  const currentPage = Math.min(
    Math.max(Number.isFinite(requestedPage) ? requestedPage : 1, 1),
    totalPages,
  );
  const start = (currentPage - 1) * pageSize;
  items.forEach((item) => {
    item.hidden = true;
  });
  matchedItems.slice(start, start + pageSize).forEach((item) => {
    item.hidden = false;
  });
  const title = document.querySelector<HTMLElement>("[data-search-title]");
  const counter = document.querySelector<HTMLElement>("[data-search-count]");
  if (title)
    title.textContent = query
      ? `「${params.get("q")}」の検索結果`
      : "記事を検索";
  if (counter)
    counter.textContent = query
      ? `${matchedItems.length}件の記事が見つかりました`
      : `${matchedItems.length}件の記事`;
  const list = document.querySelector(".archive-list");
  if (list && totalPages > 1) {
    const nav = document.createElement("nav");
    nav.className = "pagination";
    nav.setAttribute("aria-label", "ページ送り");
    const hrefFor = (page: number) => {
      const next = new URLSearchParams(params);
      next.set("page", String(page));
      return `/search/?${next.toString()}`;
    };
    const previous =
      currentPage > 1
        ? `<a class="pagination-arrow" rel="prev" href="${hrefFor(currentPage - 1)}">← 前へ</a>`
        : "<span></span>";
    const pages = Array.from({ length: totalPages }, (_, index) => index + 1)
      .map(
        (page) =>
          `<a href="${hrefFor(page)}" class="${page === currentPage ? "active" : ""}" ${page === currentPage ? 'aria-current="page"' : ""}>${page}</a>`,
      )
      .join("");
    const next =
      currentPage < totalPages
        ? `<a class="pagination-arrow" rel="next" href="${hrefFor(currentPage + 1)}">次へ →</a>`
        : "<span></span>";
    nav.innerHTML = `${previous}<div class="pagination-pages">${pages}</div>${next}`;
    list.insertAdjacentElement("afterend", nav);
  }
</script>

<style is:global>
  .search-page .pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
    margin: 42px 0;
  }
  .search-page .pagination-pages {
    display: flex;
    justify-content: center;
    gap: 8px;
  }
  .search-page .pagination a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    height: 38px;
    padding: 0 10px;
    border: 1px solid var(--line);
    background: var(--white);
    font-size: 0.85rem;
  }
  .search-page .pagination a:hover {
    border-color: var(--teal);
    color: var(--teal);
  }
  .search-page .pagination a.active {
    border-color: var(--teal);
    background: var(--teal);
    color: #fff;
    font-weight: 700;
  }
  .search-page .pagination-arrow:first-child {
    justify-self: start;
  }
  .search-page .pagination-arrow:last-child {
    justify-self: end;
  }
  @media (max-width: 600px) {
    .search-page .pagination {
      grid-template-columns: 1fr 1fr;
    }
    .search-page .pagination-pages {
      grid-column: 1/-1;
      grid-row: 1;
      flex-wrap: wrap;
    }
    .search-page .pagination-arrow {
      grid-row: 2;
    }
    .search-page .pagination-arrow:last-child {
      grid-column: 2;
    }
  }
</style>
